from pathlib import Path

path = Path("/mnt/data/WRO_prototipo_codigo_espanol.ino")
text = path.read_text(encoding="utf-8")

# Corregir palabras reservadas de C++ que no deben traducirse.
text = text.replace("falso", "false")

# Completar traducciones pendientes en comentarios.
text = text.replace("// ── Motor pins ────────────────────────────────",
                    "// ── Pines del motor ───────────────────────────")
text = text.replace("// ── Ultrasonic sensor pins ────────────────────",
                    "// ── Pines de sensores ultrasónicos ────────────")
text = text.replace("// ── Color sensor (TCS3200) ────────────────────",
                    "// ── Sensor de color (TCS3200) ─────────────────")
text = text.replace("// ── Obstacle avoidance (closed loop) ──────────",
                    "// ── Evasión de obstáculos (lazo cerrado) ──────")
text = text.replace("// ── Continuous steering (anti zig-zag) ────────",
                    "// ── Dirección continua (anti zigzag) ──────────")
text = text.replace("// ── State ─────────────────────────────────────",
                    "// ── Estado ─────────────────────────────────────")

# Completar traducciones pendientes en textos del Monitor Serial.
text = text.replace(
    'Serial.println("  go       -> autonomous conduciendo (L/R + front avoidance)");',
    'Serial.println("  go       -> conduccion autonoma (I/D + evasion frontal)");'
)
text = text.replace(
    'Serial.println("  s:<deg>  -> servo angulo");',
    'Serial.println("  s:<grados> -> angulo del servo");'
)
text = text.replace(
    'Serial.println(">> GO: autonomous conduciendo. Send m:s to stop.");',
    'Serial.println(">> GO: conduccion autonoma. Envia m:s para detener.");'
)
text = text.replace(
    'Serial.println("Invalid angulo. Use 0-180.");',
    'Serial.println("Angulo invalido. Usa 0-180.");'
)
text = text.replace(
    'Serial.print("cm - evadiendo to the ");',
    'Serial.print("cm - evadiendo hacia la ");'
)

# La última línea del pegado era una nota en inglés, no código válido.
text = text.replace(
    "\nthis was our first prototype code",
    "\n// Este fue nuestro primer código prototipo"
)

path.write_text(text, encoding="utf-8")

# Verificaciones simples para detectar errores introducidos por la traducción.
checks = {
    "usa_false_cpp": "false" in text,
    "no_contiene_falso": "falso" not in text,
    "nota_final_comentada": "// Este fue nuestro primer código prototipo" in text,
    "llaves_balanceadas": text.count("{") == text.count("}"),
}

print("Archivo corregido:", path.name)
for k, v in checks.items():
    print(f"{k}: {v}")

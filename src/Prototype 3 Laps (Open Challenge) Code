//  WRO 2026 - OPEN Challenge - SENTIDO HORARIO
//  Arduino Mega
//  Seguimiento centrado de paredes + conteo de vueltas con TCS3200
// ═══════════════════════════════════════════════════════

#include <Servo.h>

// ── Servo ────────────────────────────────────────────────
Servo servoDireccion;

#define PIN_SERVO              9
#define SERVO_CENTRO           90
#define SERVO_IZQUIERDA        60
#define SERVO_DERECHA          140
#define SERVO_LEVE_IZQUIERDA   75
#define SERVO_LEVE_DERECHA     105

// ── Pines del motor ──────────────────────────────────────
#define ENA  12
#define IN1  11
#define IN2  10

#define VELOCIDAD_ALTA  200

// ── Pines de sensores ultrasónicos ───────────────────────
#define TRIG_FRONTAL      30
#define ECO_FRONTAL       32

#define TRIG_IZQUIERDA    24
#define ECO_IZQUIERDA     22

#define TRIG_DERECHA      50
#define ECO_DERECHA       52

// ── Pines del sensor de color ────────────────────────────
#define S0      34
#define S1      36
#define S2      38
#define S3      40
#define SALIDA  42

// ── Umbrales de color obtenidos de la calibración ────────
#define VERDE_MIN_NARANJA  35
#define ROJO_MAX_NARANJA   40
#define VERDE_MIN_AZUL     70

// ── Configuración del seguimiento de paredes ─────────────
#define DISTANCIA_FRONTAL_GIRO  25  // cm - demasiado cerca del frente, girar
#define TOLERANCIA_PARED         8  // cm - error aceptable

// ── Conteo de vueltas ────────────────────────────────────
#define TOTAL_LINEAS_NARANJAS  12

int contadorNaranja = 0;
int contadorAzul    = 0;

bool anteriorNaranja = false;
bool anteriorAzul    = false;

unsigned long tiempoUltimaLinea = 0;

#define TIEMPO_ESPERA_LINEA  1500  // ms entre detecciones

bool funcionando = false;
bool terminado   = false;


// ─────────────────────────────────────────────────────────
//  Leer distancia ultrasónica (cm)
// ─────────────────────────────────────────────────────────
float leerDistancia(int pinTrig, int pinEco) {

  digitalWrite(pinTrig, LOW);
  delayMicroseconds(2);

  digitalWrite(pinTrig, HIGH);
  delayMicroseconds(10);

  digitalWrite(pinTrig, LOW);

  long duracion =
    pulseIn(
      pinEco,
      HIGH,
      30000
    );

  if (duracion == 0) {
    return 999;
  }

  float distancia =
    duracion * 0.034 / 2.0;

  if (distancia > 400) {
    return 999;
  }

  return distancia;
}


// ─────────────────────────────────────────────────────────
//  Leer un canal del sensor de color
// ─────────────────────────────────────────────────────────
int leerCanal(
  int valorS2,
  int valorS3
) {

  digitalWrite(
    S2,
    valorS2
  );

  digitalWrite(
    S3,
    valorS3
  );

  delay(10);

  return pulseIn(
    SALIDA,
    LOW,
    100000
  );
}


// ─────────────────────────────────────────────────────────
//  Detectar línea:
//  0 = nada
//  1 = naranja
//  2 = azul
// ─────────────────────────────────────────────────────────
int detectarLinea() {

  int rojo =
    leerCanal(
      LOW,
      LOW
    );

  int verde =
    leerCanal(
      HIGH,
      HIGH
    );


  // Azul
  if (
    verde >
    VERDE_MIN_AZUL
  ) {

    return 2;
  }


  // Naranja
  if (
    verde >
    VERDE_MIN_NARANJA &&
    rojo <
    ROJO_MAX_NARANJA
  ) {

    return 1;
  }


  return 0;
}


// ─────────────────────────────────────────────────────────
//  Control del motor
// ─────────────────────────────────────────────────────────
void avanzar() {

  analogWrite(
    ENA,
    VELOCIDAD_ALTA
  );

  digitalWrite(
    IN1,
    HIGH
  );

  digitalWrite(
    IN2,
    LOW
  );
}


void detenerMotor() {

  digitalWrite(
    ENA,
    LOW
  );

  digitalWrite(
    IN1,
    LOW
  );

  digitalWrite(
    IN2,
    LOW
  );
}


// ─────────────────────────────────────────────────────────
//  Seguimiento de paredes
//
//  Mantiene el robot centrado entre las paredes
//  izquierda y derecha.
//
//  Error = distancia izquierda - distancia derecha
//
//  En sentido horario:
//  pared frontal cercana = giro hacia la derecha
// ─────────────────────────────────────────────────────────
void seguirParedes() {

  float distanciaFrontal =
    leerDistancia(
      TRIG_FRONTAL,
      ECO_FRONTAL
    );

  float distanciaIzquierda =
    leerDistancia(
      TRIG_IZQUIERDA,
      ECO_IZQUIERDA
    );

  float distanciaDerecha =
    leerDistancia(
      TRIG_DERECHA,
      ECO_DERECHA
    );


  Serial.print("F:");
  Serial.print(distanciaFrontal);

  Serial.print(" I:");
  Serial.print(distanciaIzquierda);

  Serial.print(" D:");
  Serial.println(distanciaDerecha);


  // ───────────────────────────────────────────────────────
  // Pared frontal demasiado cerca
  // → girar a la derecha
  // ───────────────────────────────────────────────────────

  if (
    distanciaFrontal <
    DISTANCIA_FRONTAL_GIRO
  ) {

    servoDireccion.write(
      SERVO_DERECHA
    );

    avanzar();

    return;
  }


  // ───────────────────────────────────────────────────────
  // Centrarse entre pared izquierda y derecha
  //
  // error > 0:
  // hay más distancia a la izquierda
  // → corregir hacia la izquierda
  //
  // error < 0:
  // hay más distancia a la derecha
  // → corregir hacia la derecha
  // ───────────────────────────────────────────────────────

  float error =
    distanciaIzquierda -
    distanciaDerecha;


  if (
    error >
    TOLERANCIA_PARED
  ) {

    servoDireccion.write(
      SERVO_LEVE_IZQUIERDA
    );
  }

  else if (
    error <
    -TOLERANCIA_PARED
  ) {

    servoDireccion.write(
      SERVO_LEVE_DERECHA
    );
  }

  else {

    servoDireccion.write(
      SERVO_CENTRO
    );
  }


  avanzar();
}


// ─────────────────────────────────────────────────────────
//  Configuración inicial
// ─────────────────────────────────────────────────────────
void setup() {

  Serial.begin(9600);


  // Servo
  servoDireccion.attach(
    PIN_SERVO
  );

  servoDireccion.write(
    SERVO_CENTRO
  );


  // Motor
  pinMode(
    ENA,
    OUTPUT
  );

  pinMode(
    IN1,
    OUTPUT
  );

  pinMode(
    IN2,
    OUTPUT
  );

  detenerMotor();


  // Sensor ultrasónico frontal
  pinMode(
    TRIG_FRONTAL,
    OUTPUT
  );

  pinMode(
    ECO_FRONTAL,
    INPUT
  );


  // Sensor ultrasónico izquierdo
  pinMode(
    TRIG_IZQUIERDA,
    OUTPUT
  );

  pinMode(
    ECO_IZQUIERDA,
    INPUT
  );


  // Sensor ultrasónico derecho
  pinMode(
    TRIG_DERECHA,
    OUTPUT
  );

  pinMode(
    ECO_DERECHA,
    INPUT
  );


  // Sensor de color
  pinMode(
    S0,
    OUTPUT
  );

  pinMode(
    S1,
    OUTPUT
  );

  pinMode(
    S2,
    OUTPUT
  );

  pinMode(
    S3,
    OUTPUT
  );

  pinMode(
    SALIDA,
    INPUT
  );


  // Escalado de frecuencia al 20%
  digitalWrite(
    S0,
    HIGH
  );

  digitalWrite(
    S1,
    LOW
  );


  delay(500);


  Serial.println(
    "Listo. Envia cualquier tecla para INICIAR."
  );


  while (
    !Serial.available()
  ) {

    delay(10);
  }


  Serial.read();


  funcionando = true;


  Serial.println(
    "INICIANDO - SENTIDO HORARIO"
  );
}


// ─────────────────────────────────────────────────────────
//  Bucle principal
// ─────────────────────────────────────────────────────────
void loop() {


  // ───────────────────────────────────────────────────────
  // Si terminó, mantener todo detenido
  // ───────────────────────────────────────────────────────

  if (
    terminado
  ) {

    detenerMotor();

    servoDireccion.write(
      SERVO_CENTRO
    );

    return;
  }


  // ───────────────────────────────────────────────────────
  // Conteo de líneas con el sensor de color
  // ───────────────────────────────────────────────────────

  unsigned long ahora =
    millis();


  if (
    ahora -
    tiempoUltimaLinea >
    TIEMPO_ESPERA_LINEA
  ) {

    int linea =
      detectarLinea();


    // ── Línea naranja ─────────────────────────────────────

    if (
      linea == 1 &&
      !anteriorNaranja
    ) {

      contadorNaranja++;

      anteriorNaranja = true;

      anteriorAzul = false;

      tiempoUltimaLinea =
        ahora;


      Serial.print(
        "NARANJA #"
      );

      Serial.print(
        contadorNaranja
      );

      Serial.print(
        " / "
      );

      Serial.println(
        TOTAL_LINEAS_NARANJAS
      );
    }


    // ── Línea azul ────────────────────────────────────────

    else if (
      linea == 2 &&
      !anteriorAzul
    ) {

      contadorAzul++;

      anteriorAzul = true;

      anteriorNaranja = false;

      tiempoUltimaLinea =
        ahora;


      Serial.print(
        "AZUL #"
      );

      Serial.println(
        contadorAzul
      );
    }


    // ── Sin línea ─────────────────────────────────────────

    else if (
      linea == 0
    ) {

      anteriorNaranja = false;

      anteriorAzul = false;
    }
  }


  // ───────────────────────────────────────────────────────
  // Condición de parada:
  //
  // 12 líneas naranjas + 1 línea azul
  // = 3 vueltas completas
  // ───────────────────────────────────────────────────────

  if (
    contadorNaranja >=
    TOTAL_LINEAS_NARANJAS &&
    contadorAzul >= 1
  ) {

    terminado = true;


    detenerMotor();


    servoDireccion.write(
      SERVO_CENTRO
    );


    Serial.println(
      "3 VUELTAS COMPLETAS - DETENIDO"
    );


    return;
  }


  // ───────────────────────────────────────────────────────
  // Conducción
  // ───────────────────────────────────────────────────────

  if (
    funcionando
  ) {

    seguirParedes();
  }
}

// ─────────────────────────────────────────────
//  4x Ultrasonic Distance Sensor - Arduino Mega
//  Sensors: Front, Back, Left, Right
// ─────────────────────────────────────────────

// ── Pin definitions ──────────────────────────
#define TRIG_L 24
#define ECHO_L 22

#define TRIG_B 28
#define ECHO_B 26

#define TRIG_F 30
#define ECHO_F 32

#define TRIG_R 50
#define ECHO_R 52

// ── Config ────────────────────────────────────
#define SOUND_SPEED     0.034   // cm per microsecond
#define MAX_DISTANCE    400     // cm - beyond this = out of range
#define READ_INTERVAL   100     // ms between full sensor sweeps

// ─────────────────────────────────────────────
//  Read distance from a single sensor (cm)
//  Returns -1 if out of range or no echo
// ─────────────────────────────────────────────
float readDistance(int trigPin, int echoPin) {
  // Clear trig pin
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  // Send 10us pulse
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  // Measure echo duration (timeout = 30ms)
  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) return -1;  // No echo received

  float distance = duration * SOUND_SPEED / 2.0;

  if (distance > MAX_DISTANCE) return -1;  // Out of range

  return distance;
}

// ─────────────────────────────────────────────
//  Print a distance reading with label
// ─────────────────────────────────────────────
void printDistance(const char* label, float dist) {
  Serial.print(label);
  Serial.print(": ");
  if (dist < 0) {
    Serial.print("OUT OF RANGE");
  } else {
    Serial.print(dist, 1);   // 1 decimal place
    Serial.print(" cm");
  }
  Serial.print("   ");       // spacing between readings
}

// ─────────────────────────────────────────────
//  Setup
// ─────────────────────────────────────────────
void setup() {
  Serial.begin(9600);

  // Set all trig pins as OUTPUT, echo pins as INPUT
  int trigPins[] = { TRIG_L, TRIG_B, TRIG_F, TRIG_R };
  int echoPins[] = { ECHO_L, ECHO_B, ECHO_F, ECHO_R };

  for (int i = 0; i < 4; i++) {
    pinMode(trigPins[i], OUTPUT);
    pinMode(echoPins[i], INPUT);
    digitalWrite(trigPins[i], LOW);
  }

  Serial.println("=================================");
  Serial.println("  4x Ultrasonic Sensor Monitor  ");
  Serial.println("=================================");
  delay(500);
}

// ─────────────────────────────────────────────
//  Loop
// ─────────────────────────────────────────────
void loop() {
  float distF = readDistance(TRIG_F, ECHO_F);
  float distB = readDistance(TRIG_B, ECHO_B);
  float distL = readDistance(TRIG_L, ECHO_L);
  float distR = readDistance(TRIG_R, ECHO_R);

  printDistance("FRONT", distF);
  printDistance("BACK",  distB);
  printDistance("LEFT",  distL);
  printDistance("RIGHT", distR);

  Serial.println();   // newline after all 4 readings

  delay(READ_INTERVAL);
}




// CÓDIGO DE PROTOTIPO 1

// ─────────────────────────────────────────────
//  Sensor de distancia ultrasónico x4 - Arduino Mega
//  Sensores: Frontal, Trasero, Izquierdo, Derecho
// ─────────────────────────────────────────────

// ── Definición de pines ──────────────────────
#define TRIG_IZQUIERDA 24
#define ECO_IZQUIERDA 22

#define TRIG_TRASERO 28
#define ECO_TRASERO 26

#define TRIG_FRONTAL 30
#define ECO_FRONTAL 32

#define TRIG_DERECHA 50
#define ECO_DERECHA 52

// ── Configuración ─────────────────────────────
#define VELOCIDAD_SONIDO   0.034   // cm por microsegundo
#define DISTANCIA_MAXIMA   400     // cm - más allá de esto = fuera de rango
#define INTERVALO_LECTURA  100     // ms entre lecturas completas de sensores

// ─────────────────────────────────────────────
//  Leer distancia de un solo sensor (cm)
//  Devuelve -1 si está fuera de rango o no recibe eco
// ─────────────────────────────────────────────
float leerDistancia(int pinTrig, int pinEco) {

  // Limpiar pin TRIG
  digitalWrite(pinTrig, LOW);
  delayMicroseconds(2);

  // Enviar pulso de 10 us
  digitalWrite(pinTrig, HIGH);
  delayMicroseconds(10);
  digitalWrite(pinTrig, LOW);

  // Medir duración del eco (tiempo máximo = 30 ms)
  long duracion = pulseIn(pinEco, HIGH, 30000);

  if (duracion == 0) {
    return -1;  // No se recibió eco
  }

  float distancia =
    duracion * VELOCIDAD_SONIDO / 2.0;

  if (distancia > DISTANCIA_MAXIMA) {
    return -1;  // Fuera de rango
  }

  return distancia;
}

// ─────────────────────────────────────────────
//  Imprimir una lectura de distancia con etiqueta
// ─────────────────────────────────────────────
void imprimirDistancia(
  const char* etiqueta,
  float distancia
) {

  Serial.print(etiqueta);
  Serial.print(": ");

  if (distancia < 0) {

    Serial.print("FUERA DE RANGO");

  } else {

    Serial.print(
      distancia,
      1
    );  // 1 decimal

    Serial.print(" cm");
  }

  Serial.print("   ");  // Espacio entre lecturas
}

// ─────────────────────────────────────────────
//  Configuración inicial
// ─────────────────────────────────────────────
void setup() {

  Serial.begin(9600);

  // Configurar todos los pines TRIG como OUTPUT
  // y los pines ECHO como INPUT

  int pinesTrig[] = {
    TRIG_IZQUIERDA,
    TRIG_TRASERO,
    TRIG_FRONTAL,
    TRIG_DERECHA
  };

  int pinesEco[] = {
    ECO_IZQUIERDA,
    ECO_TRASERO,
    ECO_FRONTAL,
    ECO_DERECHA
  };

  for (int i = 0; i < 4; i++) {

    pinMode(
      pinesTrig[i],
      OUTPUT
    );

    pinMode(
      pinesEco[i],
      INPUT
    );

    digitalWrite(
      pinesTrig[i],
      LOW
    );
  }

  Serial.println(
    "================================="
  );

  Serial.println(
    " Monitor de 4 sensores ultrasonicos "
  );

  Serial.println(
    "================================="
  );

  delay(500);
}

// ─────────────────────────────────────────────
//  Bucle principal
// ─────────────────────────────────────────────
void loop() {

  float distanciaFrontal =
    leerDistancia(
      TRIG_FRONTAL,
      ECO_FRONTAL
    );

  float distanciaTrasera =
    leerDistancia(
      TRIG_TRASERO,
      ECO_TRASERO
    );

  float distanciaIzquierda =
    leerDistancia(
      TRIG_IZQUIERDA,
      ECO_IZQUIERDA
    );

  float distanciaDerecha =
    leerDistancia(
      TRIG_DERECHA,
      ECO_DERECHA
    );


  imprimirDistancia(
    "FRONTAL",
    distanciaFrontal
  );

  imprimirDistancia(
    "TRASERO",
    distanciaTrasera
  );

  imprimirDistancia(
    "IZQUIERDA",
    distanciaIzquierda
  );

  imprimirDistancia(
    "DERECHA",
    distanciaDerecha
  );


  // Nueva línea después de las 4 lecturas
  Serial.println();


  delay(
    INTERVALO_LECTURA
  );
}

// Este fue nuestro primer código prototipo.

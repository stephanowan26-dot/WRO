//
//  La primera prueba realizada con este robot: simplemente confirma que
//  los motores DG01D giran hacia adelante mediante el controlador L298N
//  a una velocidad PWM fija. Todavía no hay dirección, sensores ni lógica;
//  este fue el primer paso antes de desarrollar cualquier código de
//  sensores o conducción.
// ─────────────────────────────────────────────

#define ENA 12
#define IN1 11
#define IN2 10

void setup() {
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  analogWrite(ENA, 200);
}

void loop() {
}


#include <Sentry.h>
#include <Wire.h>

typedef Sentry2 Sentry;
Sentry sentry;

void setup() {
  Serial.begin(9600);
  Wire.begin();
  
  Serial.println("Connecting to Sentry2...");
  while (SENTRY_OK != sentry.begin(&Wire)) {
    Serial.println("Waiting...");
    delay(500);
  }
  Serial.println("Sentry2 ready!");

  sentry.VisionBegin(Sentry::kVisionBlob);
  Serial.println("Ready! Show red or green blob to camera.");
}

void loop() {
  int detected = sentry.GetValue(Sentry::kVisionBlob, kStatus);

  if (detected > 0) {
    for (int i = 1; i <= detected; i++) {
      int label = sentry.GetValue(Sentry::kVisionBlob, kLabel, i);
      int x     = sentry.GetValue(Sentry::kVisionBlob, kXValue, i);

      if (label == 13) {
        Serial.print("RED detected! X:");
        Serial.println(x);

      } else if (label == 14) {
        Serial.print("GREEN detected! X:");
        Serial.println(x);
      }
    }
  } else {
    Serial.println("Nothing detected");
  }

  delay(200);
}
